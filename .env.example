# ─────────────────────────────────────────────
# PENZO — Environment Configuration Example
# Copy to .env and fill in real values.
# NEVER commit a real .env file with credentials.
# ─────────────────────────────────────────────

# Application environment: development | production
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/penzo
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/penzo
MONGODB_URI=mongodb://127.0.0.1:27017/penzo

# Session secret — must be at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Session lifetime in hours
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8

# OTP configuration
# OTP_PROVIDER: "development" (print to console) | "sms" (real SMS gateway)
# WARNING: "development" is blocked in NODE_ENV=production
OTP_PROVIDER=development
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# SMS provider credentials (required when OTP_PROVIDER=sms)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=PENZO

# Initial super-admin account (used by `npm run admin:create`)
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace_me_with_a_secure_password
ADMIN_BOOTSTRAP_NAME=Administrator

# File storage directory for uploaded documents
STORAGE_LOCAL_DIR=./storage
