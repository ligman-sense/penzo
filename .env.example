# ─────────────────────────────────────────────
# PENZO — Environment Configuration Example
# Copy to .env and fill in real values.
# NEVER commit a real .env file with credentials.
# ─────────────────────────────────────────────

# Application environment: development | production
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/penzo
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/penzo
MONGODB_URI=mongodb://127.0.0.1:27017/penzo

# Session secret — must be at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=penzo_dev_secret_key_1234567890abcdefghijklmnopqrstuvwxyz
# Session lifetime in hours
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8

# Initial super-admin account (used by `npm run admin:create`)
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace_me_with_a_secure_password
ADMIN_BOOTSTRAP_NAME=Administrator

# File storage directory for uploaded documents
STORAGE_LOCAL_DIR=./storage

# Google OAuth 2.0 Credentials (Candidate & Volunteer sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Resend Email Configuration (Password Reset)
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM="PENZO <onboarding@resend.dev>"
PASSWORD_RESET_OTP_EXPIRY=300
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN=60

