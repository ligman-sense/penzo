# ==============================================================================
# PENZO — Production & Development Environment Configuration
# ==============================================================================
# Instructions:
# 1. For local development: copy this file to `.env` and adjust as needed.
# 2. For production hosting (Render, Railway, etc.): add these keys to the
#    hosting platform's "Environment Variables" dashboard.
# 3. NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Node environment: 'development' (local) or 'production' (cloud hosting)
NODE_ENV=development

# Port the Express server listens on.
# Cloud providers (e.g., Render, Railway) assign this automatically via $PORT.
PORT=3000

# Public URL of your deployed application (without trailing slash).
# Used for constructing OAuth redirect URIs and absolute resource links.
# Example: https://penzo.onrender.com (or http://localhost:3000 for local dev)
APP_URL=http://localhost:3000

# Reverse Proxy Trust (Required for Render, Railway, Nginx, Cloudflare)
# Set to '1' in production to allow Express to read X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Local Development:
# MONGODB_URI=mongodb://127.0.0.1:27017/penzo
#
# Production (MongoDB Atlas Free M0 Cluster or higher):
# Format: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/penzo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/penzo

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, SECURITY & SESSIONS
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session cookies. Must be at least 32 characters.
# Generate on command line with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=penzo_dev_secret_key_1234567890abcdefghijklmnopqrstuvwxyz

# Session lifetimes (in hours)
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8

# Allowed CORS origins (comma-separated). Leave empty if serving frontend and
# backend from the same domain (recommended for unified deployment).
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 4. SUPER-ADMINISTRATOR INITIALIZATION
# ------------------------------------------------------------------------------
# Credentials for the initial Super-Admin account. On server startup, if these
# are set and no admin user with this email exists, the account will be created.
# Redeployments will verify the account without overwriting existing passwords.
ADMIN_BOOTSTRAP_EMAIL=admin@penzo.edu
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeOnFirstLogin123!
ADMIN_BOOTSTRAP_NAME="Super Administrator"

# ------------------------------------------------------------------------------
# 5. BACKGROUND SCHEDULER
# ------------------------------------------------------------------------------
# Controls whether the 2-day unresolved-request alert scheduler runs on this instance.
# Set to 'true' for single-instance web services, or 'false' for secondary replicas.
ENABLE_BACKGROUND_SCHEDULER=true

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS & PASSWORD RESET (Resend)
# ------------------------------------------------------------------------------
# Get your free API key at https://resend.com (3,000 emails/month free tier).
# If left blank, password reset OTPs are simulated and logged to the server console.
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM="PENZO <onboarding@resend.dev>"
PASSWORD_RESET_OTP_EXPIRY=300
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN=60

# ------------------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Candidate & Volunteer sign-in)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# SMS Verification (optional; 'development' logs OTPs to server console)
OTP_PROVIDER=development
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
